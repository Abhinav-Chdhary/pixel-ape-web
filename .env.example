ZCP_API_KEY=your-zcp-key
ZEROPS_TOKEN=your_integration_token

# Public Supabase browser configuration.
# Find these in Supabase: Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_API_URL=https://your-public-api-origin

# Set these only on the Zerops `api` service, never in a Vite environment file.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# ALLOWED_ORIGIN=https://your-public-frontend-origin

# Google and GitHub OAuth credentials are configured in the Supabase dashboard.
# Loops SMTP credentials are configured through the Loops/Supabase integration.
# Never place Supabase secret/service-role keys or Loops API keys in VITE_* variables.
